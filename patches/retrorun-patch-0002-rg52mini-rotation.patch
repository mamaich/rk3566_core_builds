+
+// The RG52 Mini takes the RG351P's choices turned half a turn, in the
+// presenter and in the blits (screenshots, on-screen messages) alike.
+static rr_rotation_t rotate180(rr_rotation_t r)
+{
+    return static_cast<rr_rotation_t>((static_cast<int>(r) + 2) % 4);
+}
+
+rr_rotation_t getBlitRotation()
+{
+    rr_rotation_t r = getBlitRotationBase();
+    return isRG52Mini() ? rotate180(r) : r;
+}
+
+rr_rotation_t getRotation()
+{
+    rr_rotation_t r = getRotationBase();
+    return isRG52Mini() ? rotate180(r) : r;
+}
