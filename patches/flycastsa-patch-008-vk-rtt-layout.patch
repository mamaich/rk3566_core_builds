From d5e74ad756b6029c5f39d9380bda2b2bbe659b9e Mon Sep 17 00:00:00 2001
From: Flyinghead <raphael.jean@gmail.com>
Date: Thu, 20 Aug 2026 15:18:20 +0200
Subject: [PATCH] vk: fix RTT initial color attachment layout

Fixes Miss Moonlight color attachment layout mismatch error.
---
 core/rend/vulkan/oit/oit_drawer.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/core/rend/vulkan/oit/oit_drawer.h b/core/rend/vulkan/oit/oit_drawer.h
index 7ea1a5613..5937a729b 100644
--- a/core/rend/vulkan/oit/oit_drawer.h
+++ b/core/rend/vulkan/oit/oit_drawer.h
@@ -231,7 +231,7 @@ protected:
 	vk::CommandBuffer NewFrame() override;
 	vk::Framebuffer getFramebuffer(int renderPass, int renderPassCount) override;
 	vk::ImageLayout getAttachmentInitialLayout() override {
-		return config::RenderToTextureBuffer ? vk::ImageLayout::eTransferSrcOptimal : vk::ImageLayout::eShaderReadOnlyOptimal;
+		return vk::ImageLayout::eShaderReadOnlyOptimal;
 	}
 
 private:
