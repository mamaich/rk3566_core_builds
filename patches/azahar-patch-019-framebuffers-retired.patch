From: TheGammaSqueeze (GammaOS), azahar-nano
Subject: A dropped Vulkan framebuffer outlives the render passes recorded with it

GammaOSNextDistribution-14 1feeb9c2d16 (2026-10-25), the core's part
(gammaos/emulators/azahar-nano), unchanged:

When a surface is recreated with storage usage the rasterizer cache
drops the framebuffers built on its old views, and their destructor
destroyed the Vulkan framebuffer at once. The scheduler records on its
own thread, so a render pass already queued with that framebuffer was
recorded and run against a freed object: Monster Hunter 3 Ultimate
crashed in the driver on its first run right after creating data.
The framebuffer is now retired like the replaced images and destroyed
once the GPU has finished the tick.

Rebased onto Azahar 2127.0.1 for dArkOS 1.13 (2026-11-26, a git rebase of the series; conflicts resolved by hand).

diff --git a/src/video_core/renderer_vulkan/vk_texture_runtime.cpp b/src/video_core/renderer_vulkan/vk_texture_runtime.cpp
index 88e0b579236f55a8a0f403354cf199def51368a1..c06dc7c407e675b61f5ff9abff77c9d5d97f563a 100644
--- a/src/video_core/renderer_vulkan/vk_texture_runtime.cpp
+++ b/src/video_core/renderer_vulkan/vk_texture_runtime.cpp
@@ -314,6 +314,24 @@ TextureRuntime::TextureRuntime(const Instance& instance, Scheduler& scheduler,
 
 TextureRuntime::~TextureRuntime() {
     g_pending_clear_owner = nullptr;
+    const auto device = instance.GetDevice();
+    for (const RetiredFramebuffer& r : retired_framebuffers) {
+        device.destroyFramebuffer(r.framebuffer);
+    }
+    retired_framebuffers.clear();
+}
+
+void TextureRuntime::RetireFramebuffer(vk::Framebuffer framebuffer) {
+    const auto device = instance.GetDevice();
+    const u64 done = scheduler.GetMasterSemaphore()->KnownGpuTick();
+    std::erase_if(retired_framebuffers, [&](const RetiredFramebuffer& r) {
+        if (r.tick > done) {
+            return false;
+        }
+        device.destroyFramebuffer(r.framebuffer);
+        return true;
+    });
+    retired_framebuffers.push_back(RetiredFramebuffer{scheduler.CurrentTick(), framebuffer});
 }
 
 VideoCore::StagingData TextureRuntime::FindStaging(u32 size, bool upload) {
@@ -1747,7 +1765,7 @@ void Surface::BlitScale(const VideoCore::TextureBlit& blit, bool up_scale) {
 
 Framebuffer::Framebuffer(TextureRuntime& runtime, const VideoCore::FramebufferParams& params,
                          Surface* color, Surface* depth)
-    : VideoCore::FramebufferParams{params}, instance{runtime.GetInstance()},
+    : VideoCore::FramebufferParams{params}, instance{runtime.GetInstance()}, runtime{&runtime},
       res_scale{color ? color->res_scale : (depth ? depth->res_scale : 1u)},
       sample_count{color ? color->sample_count : (depth ? depth->sample_count : u8(1u))} {
     auto& renderpass_cache = runtime.GetRenderpassCache();
@@ -1819,7 +1837,16 @@ Framebuffer::Framebuffer(TextureRuntime& runtime, const VideoCore::FramebufferPa
 }
 
 Framebuffer::~Framebuffer() {
-    if (framebuffer) {
+    if (!framebuffer) {
+        return;
+    }
+    // A framebuffer dropped by the cache (a surface recreated with storage usage, see
+    // Surface::EnsureStorage) may still be referenced by render passes the scheduler has not
+    // recorded or the GPU has not run: destroying it here crashed the driver on the worker
+    // thread inside the next pass that used it (Monster Hunter 3 Ultimate after creating data).
+    if (runtime) {
+        runtime->RetireFramebuffer(framebuffer);
+    } else {
         instance.GetDevice().destroyFramebuffer(framebuffer);
     }
 }
