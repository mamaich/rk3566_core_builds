From: dArkOS RG52 Mini port
Subject: nogui DRM: hotkeys (008, 010 and 012 of the e6583f8 series, on 2609a)

Hotkey plus Start quits, L/R load/save the slot, Up/Down pick it,
Left/Right change the speed limit by 10%, X toggles the FPS counter.
The Hotkey input comes after Start in the button group, matching
button_bitmasks. Its bit, 0x2000, is PAD_GET_ORIGIN in the pad word,
so GCPad::GetInput moves it to GCPadStatus::hotkey: the game and the
SI device no longer see a held hotkey as a request to re-read the
stick origin.

diff --git a/Source/Core/Core/HW/GCPadEmu.cpp b/Source/Core/Core/HW/GCPadEmu.cpp
index dff79653c3..b47c39a833 100644
--- a/Source/Core/Core/HW/GCPadEmu.cpp
+++ b/Source/Core/Core/HW/GCPadEmu.cpp
@@ -24,6 +24,7 @@ static const u16 button_bitmasks[] = {
     PAD_BUTTON_Y,
     PAD_TRIGGER_Z,
     PAD_BUTTON_START,
+    PAD_BUTTON_HOTKEY,
     0  // MIC HAX
 };
 
@@ -48,6 +49,7 @@ GCPad::GCPad(const unsigned int index) : m_index(index)
   }
   // i18n: The START/PAUSE button on GameCube controllers
   m_buttons->AddInput(Translatability::Translate, START_BUTTON, _trans("START"));
+  m_buttons->AddInput(Translatability::Translate, HOTKEY_BUTTON, _trans("HOTKEY"));
 
   // sticks
   groups.emplace_back(m_main_stick = new ControllerEmu::OctagonAnalogStick(
@@ -150,6 +152,8 @@ GCPadStatus GCPad::GetInput() const
 
   // buttons
   m_buttons->GetState(&pad.button, button_bitmasks, m_input_override_function);
+  pad.hotkey = (pad.button & PAD_BUTTON_HOTKEY) != 0;
+  pad.button &= ~PAD_BUTTON_HOTKEY;
 
   // set analog A/B analog to full or w/e, prolly not needed
   if (pad.button & PAD_BUTTON_A)
