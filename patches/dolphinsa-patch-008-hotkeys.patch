diff --git a/Source/Core/DolphinNoGUI/PlatformDRM.cpp b/Source/Core/DolphinNoGUI/PlatformDRM.cpp
index 557841dda2..73350d2222 100644
--- a/Source/Core/DolphinNoGUI/PlatformDRM.cpp
+++ b/Source/Core/DolphinNoGUI/PlatformDRM.cpp
@@ -11,6 +11,14 @@
 #include "Core/State.h"
 #include "Core/System.h"
 
+#include <cmath>
+#include <fmt/format.h>
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/HW/GCPad.h"
+#include "InputCommon/GCPadStatus.h"
+#include "VideoCommon/OnScreenDisplay.h"
+
 #include <climits>
 #include <cstdio>
 #include <thread>
@@ -36,10 +44,77 @@ void PlatformDRM::SetTitle(const std::string& string)
 
 void PlatformDRM::MainLoop()
 {
+  Core::System& system = Core::System::GetInstance();
+  const auto show_emulation_speed = [] {
+    const float emulation_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+    OSD::AddMessage(emulation_speed <= 0 ?
+                        "Speed Limit: Unlimited" :
+                        fmt::format("Speed Limit: {}%", std::lround(emulation_speed * 100.f)));
+  };
+  // Hotkey + a button: Start quits, L/R load/save the slot, Up/Down pick it,
+  // Left/Right change the speed limit by 10%, X toggles the FPS counter.
+  int hotkey = 0;  // 1: released since the last action, 2: held, waiting for a button
+  u32 slot = 0;
+
   while (IsRunning())
   {
     UpdateRunningFlag();
-    Core::HostDispatchJobs(Core::System::GetInstance());
+    Core::HostDispatchJobs(system);
+
+    if (Pad::IsInitialized())
+    {
+      const GCPadStatus pad = Pad::GetStatus(0);
+      if (!pad.hotkey)
+        hotkey = 1;
+      else if (hotkey == 1)
+        hotkey = 2;
+
+      if (hotkey == 2)
+      {
+        const auto pressed = [&pad](u16 button) { return (pad.button & button) != 0; };
+        if (pressed(PAD_BUTTON_START))
+        {
+          RequestShutdown();
+          hotkey = 0;
+        }
+        else if (pressed(PAD_TRIGGER_L))
+        {
+          State::Load(system, slot);
+          hotkey = 0;
+        }
+        else if (pressed(PAD_TRIGGER_R))
+        {
+          State::Save(system, slot);
+          hotkey = 0;
+        }
+        else if (pressed(PAD_BUTTON_DOWN) || pressed(PAD_BUTTON_UP))
+        {
+          if (pressed(PAD_BUTTON_DOWN) && slot > 0)
+            slot--;
+          else if (pressed(PAD_BUTTON_UP) && slot < 10)
+            slot++;
+          Core::DisplayMessage(fmt::format("Slot {} selected", slot), 4000);
+          hotkey = 0;
+        }
+        else if (pressed(PAD_BUTTON_RIGHT) || pressed(PAD_BUTTON_LEFT))
+        {
+          float speed = Config::Get(Config::MAIN_EMULATION_SPEED) +
+                        (pressed(PAD_BUTTON_RIGHT) ? 0.1f : -0.1f);
+          if (speed > 0)
+          {
+            speed = (speed >= 0.95f && speed <= 1.05f) ? 1.0f : speed;
+            Config::SetCurrent(Config::MAIN_EMULATION_SPEED, speed);
+          }
+          show_emulation_speed();
+          hotkey = 0;
+        }
+        else if (pressed(PAD_BUTTON_X))
+        {
+          Config::SetCurrent(Config::GFX_SHOW_FPS, !Config::Get(Config::GFX_SHOW_FPS));
+          hotkey = 0;
+        }
+      }
+    }
 
     // TODO: Is this sleep appropriate?
     std::this_thread::sleep_for(std::chrono::milliseconds(1));
