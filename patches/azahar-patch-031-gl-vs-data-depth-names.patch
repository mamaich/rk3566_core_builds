 using namespace Pica::Shader::Generator;
+
+namespace {
+// dArkOS: azahar-nano gave the vertex stages' vs_data block depth_scale and depth_offset, and fs_data
+// has members by the same names. Neither block has an instance name, so in GLSL ES their members
+// share one namespace across a program, and Mali refuses to link every program ("a uniform block
+// with no instance object vs_data that conflicts with the member of the uniform block fs_data").
+// Vulkan compiles each stage on its own and keys its SPIR-V cache by the generated text, so only the
+// GL path renames the two, in the vertex and geometry stages. The block is bound by its binding: the
+// names never reach the C++ side.
+std::string RenameVSDepth(std::string code) {
+    static constexpr std::string_view names[] = {"depth_scale", "depth_offset"};
+    const auto ident = [](char c) {
+        return std::isalnum(static_cast<unsigned char>(c)) != 0 || c == '_';
+    };
+    std::string out;
+    out.reserve(code.size() + 64);
+    for (std::size_t i = 0; i < code.size();) {
+        bool hit = false;
+        for (const std::string_view name : names) {
+            const std::size_t end = i + name.size();
+            if (code.compare(i, name.size(), name) == 0 && (i == 0 || !ident(code[i - 1])) &&
+                (end >= code.size() || !ident(code[end]))) {
+                out += "vs_";
+                out += name;
+                i = end;
+                hit = true;
+                break;
+            }
+        }
+        if (!hit) {
+            out += code[i++];
+        }
+    }
+    return out;
+}
+
+std::string GenerateVertexShaderGL(const Pica::ShaderSetup& setup, const PicaVSConfig& config,
+                                   const ExtraVSConfig& extra) {
+    return RenameVSDepth(GLSL::GenerateVertexShader(setup, config, extra));
+}
+
+std::string GenerateFixedGeometryShaderGL(const PicaFixedGSConfig& config,
+                                          const ExtraFixedGSConfig& extra) {
+    return RenameVSDepth(GLSL::GenerateFixedGeometryShader(config, extra));
+}
+} // namespace
 using Pica::Shader::FSConfig;
 
