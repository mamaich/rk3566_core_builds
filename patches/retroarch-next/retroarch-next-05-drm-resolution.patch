From: dArkOS RG52 Mini port
Subject: DRM: the mode /var/run/drmMode names, set at the end of drm_get_encoder()

Patch 0011 of v1.22.2 for master. As it is, it applies to master with fuzz
into drm_get_resources(), before the connector and the encoder exist, so a
/var/run/drmMode would have made it read null pointers. Here it sits where
v1.22.2 had it, after the encoder is found, and sets the mode on the CRTC
master picked for it (g_drm_encoder_crtc).

diff --git a/gfx/common/drm_common.c b/gfx/common/drm_common.c
index 0ed23c7..fd96cc6 100644
--- a/gfx/common/drm_common.c
+++ b/gfx/common/drm_common.c
@@ -442,6 +442,29 @@ bool drm_get_encoder(int fd)
             drm_calc_refresh_rate(&g_drm_connector->modes[i]));
    }
 
+   /* dArkOS (as batocera): the mode /var/run/drmMode names, set on the
+    * CRTC picked above. */
+   {
+      FILE *fdDrmMode;
+      int drmMode;
+      if ((fdDrmMode = fopen("/var/run/drmMode", "r")) != NULL)
+      {
+         if (     fscanf(fdDrmMode, "%i", &drmMode) == 1
+               && drmMode >= 0 && drmMode < g_drm_connector->count_modes)
+         {
+            drmModeCrtc *pcrtc = drmModeGetCrtc(fd, g_drm_encoder_crtc);
+            if (pcrtc)
+            {
+               drmModeSetCrtc(fd, pcrtc->crtc_id, pcrtc->buffer_id, 0, 0,
+                     &g_drm_connector->connector_id, 1,
+                     &g_drm_connector->modes[drmMode]);
+               drmModeFreeCrtc(pcrtc);
+            }
+         }
+         fclose(fdDrmMode);
+      }
+   }
+
    return true;
 }
 
