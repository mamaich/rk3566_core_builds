@@ -223,7 +225,30 @@ static bool go2_find_output(gfx_ctx_go2_drm_data_t *drm)
    if (!res)
       return false;
 
-   for (i = 0; i < res->count_connectors; i++)
+   /* RK3562: /var/run/drmConn holds the index of the connector to use
