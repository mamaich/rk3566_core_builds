+   drm->rotated     = drm->mode.vdisplay > drm->mode.hdisplay;
+   drm->native_dims = drm->rotated
+      ? VIDEO_SCALE_PACK(drm->mode.vdisplay, drm->mode.hdisplay)
+      : VIDEO_SCALE_PACK(drm->mode.hdisplay, drm->mode.vdisplay);
    drm->fb_dims     = drm->native_dims;
    drm->orig_crtc   = drmModeGetCrtc(drm->fd, drm->crtc_id);
 
@@ -752,7 +778,7 @@ static void gfx_ctx_go2_drm_swap_buffers(void *data)
    dst.mmuFlag      = 1;
    dst.rect.wstride = drm->scan_wstride;
    dst.rect.hstride = drm->mode.vdisplay;
