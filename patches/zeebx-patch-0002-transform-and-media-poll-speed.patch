     /// Enfileira o aviso de fim dos sons que já terminaram.
     pub(super) fn poll_media(&mut self) -> Result<(), CpuError> {
         let now = self.now_us();
+        // **Não a cada fronteira de API.** Este método roda em toda volta e em todo callback, e
+        // percorrer todos os `IMedia` vivos a cada vez era 8% do tempo do core no Action Hero 3D
+        // (dezenas de sons, A53 do RG52 Mini, perf 2026-11-08). A lista é olhada quando o relógio
+        // do jogo andou meio milissegundo desde a última olhada: um fim de som chega no máximo
+        // isso depois. Um relógio que voltou (save state) olha na hora.
+        if now >= self.media_olhada_us && now < self.media_olhada_us.saturating_add(500) {
+            return Ok(());
+        }
+        self.media_olhada_us = now;
         let finished: Vec<u32> = self
             .media
             .iter()
